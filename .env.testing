APP_ENV=testing
APP_KEY=base64:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost
MIX_ADMIN_URL=http://neo.test

LOG_CHANNEL=stack

# 集成测试使用 sqlite 内存库，无需 MySQL 服务
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# 若需连本地 MySQL 做集成测试，可改为 mysql 并取消下面注释
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hustoj_test
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

BCRYPT_ROUNDS=4

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_DRIVER=array
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_VHOST=
RABBITMQ_QUEUE=
RABBITMQ_LOGIN=
RABBITMQ_PASSWORD=

JUDGE_SERVICE_OK=true
JUDGE_AUTH_TTL=300
JUDGE_AUTH_ALLOW_LEGACY=false
JUDGE_AUTH_CACHE_STORE=array

CAPTCHA_ENABLED=false
NOCAPTCHA_SECRET=
NOCAPTCHA_SITEKEY=
